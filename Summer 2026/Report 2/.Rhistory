knitr::opts_chunk$set(fig.height=4, fig.width=6, fig.align = "left", warning=FALSE, echo=TRUE, tidy=TRUE, tidy.opts=list(width.cutoff=60))
library(dplyr)
library(tidyverse)
library(ggplot2)
library(lubridate)
library(patchwork)
library(zoo)
library(kableExtra)
library(corrplot)
library(epidatr)
NSSP_hsa <- pub_covidcast(
source = "nssp",
signals = "pct_ed_visits_influenza",
geo_type = "hsa_nci",
time_type = "week",
)
NSSP_state <- pub_covidcast(
source = "nssp",
signals = "pct_ed_visits_influenza",
geo_type = "state",
time_type = "week",
)
# This code is used to get %ED visits by hsa and state.
# I use this code for getting population size.
library(tidycensus)
state_pop <- get_acs(
geography = "state",
variables = "B01003_001",  # total population
year = 2023,
survey = "acs5",
output = "wide"
) %>%
select(state = NAME, population = B01003_001E)
county_pop <- get_acs(
geography = "county",
variables = "B01003_001",  # total population
year = 2023,
survey = "acs5",
output = "wide"
) %>%
separate(NAME, into = c("county", "state"), sep = ", ") %>%
mutate(
county = str_remove(county, " County$")  # remove " County" in county variable
) %>%
select(fips = GEOID, county, state, population = B01003_001E)
library(readxl)
bridge_table = read_excel("Health.Service.Areas.xls")
colnames(bridge_table)[1] = "geo_value"
colnames(bridge_table)[4] = "fips"
bridge_table = bridge_table |> select(geo_value, fips)
county_hsa_pop = bridge_table |> left_join(county_pop, by = "fips")
hsa_pop = county_hsa_pop |> group_by(geo_value, state) |> summarise(population = sum(population, na.rm = TRUE))
hsa_pop = na.omit(hsa_pop) # it was just states with NA names and 0 population
hsa_data = NSSP_hsa |> select(geo_value, time_value, value)
colnames(hsa_data)[3] = "hsa_value"
hsa_data$geo_value = as.double(hsa_data$geo_value)
hsa_data = hsa_data |> left_join(hsa_pop, by = "geo_value")
colnames(hsa_data) = c("hsa_id", "time_value", "hsa_value", "state", "hsa_pop")
state_data = NSSP_state |> select(geo_value, time_value, value)
state_lookup = data.frame(
state = state.name,
geo_value = tolower(state.abb)
)
state_data = state_data |> left_join(state_lookup, by = "geo_value")
state_data = state_data |> left_join(state_pop, by = "state") |>
mutate(state = if_else(is.na(state), "District of Columbia", state)) |> select(-geo_value)
colnames(state_data) = c("time_value", "state_value", "state", "state_pop")
final_data = hsa_data |> left_join(state_data, by = c("state", "time_value"))
final_data = final_data |> select(time_value, hsa_id, state, hsa_value, state_value, hsa_pop, state_pop)
final_data$pop_ratio = final_data$hsa_pop / final_data$state_pop
write_csv(final_data, "hsa_state_new.csv")
