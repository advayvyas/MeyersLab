# Average each metric across the 3 windows per HSA, then join
dtw_avg = dtw_results_window %>%
group_by(ID) %>%
summarise(across(where(is.numeric), mean, na.rm = TRUE), .groups = "drop")
prob_avg = prob_results_window %>%
group_by(ID) %>%
summarise(across(where(is.numeric), mean, na.rm = TRUE), .groups = "drop")
comparison = dtw_avg %>%
inner_join(prob_avg, by = "ID", suffix = c("_dtw", "_prob"))
ggplot(comparison, aes(x = signed_lag, y = mean_lag)) +
geom_point(alpha = 0.5, size = 1.2, color = "#2c7bb6") +
geom_abline(linetype = "dashed", color = "grey40") +
geom_smooth(method = "lm", se = TRUE, color = "#d7191c", linewidth = 0.8) +
labs(
x     = "Deterministic Signed Lag (DTW peak-to-peak, weeks)",
y     = "Probabilistic Mean Lag (soft-DTW alignment, weeks)",
title = "Lag Comparison: Deterministic vs. Soft-DTW",
subtitle = sprintf("n = %d HSAs, averaged across 3 seasons", nrow(comparison))
) +
theme_minimal(base_size = 13) +
theme(
plot.title    = element_text(face = "bold"),
plot.subtitle = element_text(color = "grey50")
)
comparison_long = dtw_results_window %>%
inner_join(prob_results_window, by = c("ID", "peak_window"), suffix = c("_dtw", "_prob"))
ggplot(comparison_long, aes(x = signed_lag, y = mean_lag)) +
geom_point(alpha = 0.4, size = 1.0, color = "#2c7bb6") +
geom_abline(linetype = "dashed", color = "grey40") +
geom_smooth(method = "lm", se = TRUE, color = "#d7191c", linewidth = 0.8) +
facet_wrap(~ peak_window, labeller = labeller(peak_window = c(
"1" = "Season 1 (2022/23)",
"2" = "Season 2 (2023/24)",
"3" = "Season 3 (2024/25)"
))) +
labs(
x     = "Deterministic Signed Lag (weeks)",
y     = "Probabilistic Mean Lag (weeks)",
title = "Lag Comparison by Season"
) +
theme_minimal(base_size = 13) +
theme(
plot.title  = element_text(face = "bold"),
strip.text  = element_text(face = "bold")
)
