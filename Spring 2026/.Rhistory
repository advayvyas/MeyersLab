library(tidyverse)
# data prep:
sf_trees <- read_csv('https://raw.githubusercontent.com/rfordatascience/tidytuesday/master/data/2020/2020-01-28/sf_trees.csv')
tree_species <- c(
"Tristaniopsis laurina :: Swamp Myrtle",
"Lophostemon confertus :: Brisbane Box",
"Magnolia grandiflora :: Southern Magnolia",
"Pittosporum undulatum :: Victorian Box"
)
trees <- sf_trees |>
filter(
!is.na(date),
!is.na(dbh),
species %in% tree_species
) |>
mutate(
year = year(ymd(date))
) |>
filter(
year >= 1969,
dbh < 40
) |>
select(species, year, diameter = dbh)
trees
#| fig-width: 6
#| fig-height: 6
#| out-width: "75%"
# Add your code here
ggplot(trees, aes(x = year, y = diameter, color = species, shape = species)) +
geom_point(size = 7, alpha = 1, stroke = 2) +
scale_color_manual(
values = c("hotpink", "chartreuse", "cyan", "darkorange")
) +
scale_shape_manual(values = c(15, 17, 18, 25)) +
scale_x_continuous(breaks = seq(1969, 2020, by = 3)) +
scale_y_continuous(breaks = seq(0, 40, by = 3)) +
labs(
title = "!!!WOW TREES DATA PLOT!!!",
subtitle = "this is a chart about trees. there are many trees. look at them",
x = "THE YEAR (anno domini)",
y = "DIAMETER............(inches)",
color = "FULL SPECIES NAME (see legend)",
shape = "FULL SPECIES NAME (see legend)",
caption = "source: trees"
) +
theme(
plot.background    = element_rect(fill = "yellow", color = "red", linewidth = 4),
panel.background   = element_rect(fill = "lightpink"),
panel.grid.major   = element_line(color = "red",  linewidth = 2, linetype = "dotted"),
panel.grid.minor   = element_line(color = "blue", linewidth = 1.5),
axis.text.x        = element_text(angle = 90, color = "darkgreen", size = 6,  face = "bold"),
axis.text.y        = element_text(angle = 45, color = "purple",    size = 14),
axis.title.x       = element_text(color = "red",    size = 16, face = "italic"),
axis.title.y       = element_text(color = "orange", size = 8,  face = "bold.italic", angle = 0, vjust = 0.5),
plot.title         = element_text(size = 22, face = "bold", color = "blue",
hjust = 0.5, family = "serif"),
plot.subtitle      = element_text(size = 7, color = "grey20", hjust = 1, family = "mono"),
plot.caption       = element_text(size = 18, color = "hotpink", face = "bold"),
legend.background  = element_rect(fill = "lightblue", color = "purple", linewidth = 2),
legend.title       = element_text(color = "red", size = 13, face = "bold"),
legend.text        = element_text(color = "darkgreen", size = 6),
legend.position    = "bottom",
legend.direction   = "vertical"
)
ggplot(trees_labeled, aes(x = year, y = diameter, color = common)) +
geom_point(alpha = 0.18, size = 1.1, shape = 16) +
geom_smooth(method = "loess", se = TRUE, linewidth = 1.1,
alpha = 0.15, aes(fill = common)) +
facet_wrap(~common, nrow = 2) +
scale_color_manual(values = pal, guide = "none") +
scale_fill_manual(values  = pal, guide = "none") +
scale_x_continuous(
breaks = c(1975, 1990, 2005),
labels = c("'75", "'90", "'05")
) +
scale_y_continuous(breaks = seq(0, 40, 10)) +
labs(
title    = "Tree Diameter Over Time in San Francisco",
subtitle = "Each point is a tree; ribbons show a LOESS trend with 95% confidence interval",
x        = "Year planted",
y        = "Trunk diameter (in)",
caption  = "Source: SF DPW Street Trees · TidyTuesday 2020-01-28"
) +
theme_minimal(base_size = 11) +
theme(
