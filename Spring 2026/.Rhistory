),
Calculation = c(
"dtwclust::sdtw(P, Q, gamma)",
"mean(warp(i) - i) over all i",
"median(warp(i) - i) over all i",
"sd(warp(i) - i) over all i",
"mean(|warp(i) - i|) over all i",
"mean(lag(i)) for i where P[i] >= quantile(P, 0.75)",
"sqrt(mean((P - Q)^2))"
),
Analogous = c(
"frechet",
"signed_lag / centroid_time_diff",
"signed_lag",
"— (new)",
"— (new)",
"signed_lag (closest)",
"dtw_rmse"
),
check.names = FALSE
)
kable(
metrics,
format    = "html",
escape    = TRUE,
col.names = c("Metric", "Type", "Description", "R Calculation", "Analogous Existing Metric")
) |>
kable_styling(
bootstrap_options = c("striped", "hover", "condensed", "responsive"),
full_width = TRUE,
font_size  = 13
) |>
column_spec(1, bold = TRUE, monospace = TRUE, width = "12em") |>
column_spec(2, width = "7em") |>
column_spec(3, width = "28em") |>
column_spec(4, monospace = TRUE, width = "16em") |>
column_spec(5, monospace = TRUE, width = "12em") |>
row_spec(0, bold = TRUE, background = "#2c3e50", color = "white") |>
pack_rows("Soft-DTW Distance",                     1, 1, bold = TRUE) |>
pack_rows("Lag / Timing (from Soft Alignment Matrix)", 2, 6, bold = TRUE) |>
pack_rows("Magnitude Baseline",                    7, 7, bold = TRUE)
knitr::kable(metrics)
library(knitr)
library(kableExtra)
metrics = data.frame(
Metric = c(
"soft_dtw_distance",
"mean_lag",
"median_lag",
"sd_lag",
"mean_abs_lag",
"peak_region_lag",
"rmse"
),
Type = c(
"Dissimilarity",
"Timing", "Timing", "Timing", "Timing", "Timing",
"Magnitude"
),
Description = c(
"Overall curve dissimilarity under soft alignment. Penalizes both timing and magnitude differences but allows elastic warping — two curves with the same shape but shifted peaks score lower than RMSE would suggest.",
"Average signed timing offset across all weeks. Positive = HSA leads the state; negative = HSA lags. Analogous to signed_lag but derived from the full curve alignment rather than peak-to-peak difference.",
"Median of the per-week lag profile. More robust than mean_lag to outlier weeks near the trough pulling the average.",
"Standard deviation of the per-week lag profile. High sd_lag with low mean_lag suggests the HSA and state cross over in timing across the season rather than maintaining a consistent offset.",
"Mean of |lag(i)| across all weeks. Captures total temporal displacement without sign cancellation — useful when displacement direction varies across the season.",
"Mean signed lag restricted to weeks where HSA incidence >= 75th percentile. Focuses the timing signal on the epidemic peak rather than averaging over baseline and tail. Closest analog to the existing signed_lag.",
"Root mean squared error between raw HSA and state incidence with no alignment. Baseline magnitude metric assuming perfect temporal alignment."
),
Calculation = c(
"dtwclust::sdtw(P, Q, gamma)",
"mean(warp(i) - i) over all i",
"median(warp(i) - i) over all i",
"sd(warp(i) - i) over all i",
"mean(|warp(i) - i|) over all i",
"mean(lag(i)) for i where P[i] >= quantile(P, 0.75)",
"sqrt(mean((P - Q)^2))"
),
check.names = FALSE
)
knitr::kable(metrics)
